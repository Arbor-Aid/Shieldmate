```gitignore
# General
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*.orig
*.patch

# Node / JavaScript
node_modules/
dist/
dist-ssr/
.next/
.tmp/
.cache/
coverage/
.vite/
.eslintcache
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
npm-debug.log*
lerna-debug.log*
.browserslistrc.cjs

# TypeScript
*.tsbuildinfo

# Environment
.env
.env.bak
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.shieldmate
*.env.backup
.env.*.local

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log

# Flutter / Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.flutter-configuration
.melos/
build/
.ios/
android/.gradle/
android/.idea/
android/*.iml
ios/DerivedData/
ios/Pods/

# IDE / Editor
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.iml
*.sw?

# Generated Artifacts
build/windows/
build/linux/
build/macos/
build/web/
build/ios/
build/android/
flutter_export_environment.sh

# Local Flutter SDK / vendored SDK folders
.flutter/
/flutter/

# Misc
Thumbs.db
nuget.exe
shieldmate_cleanup.ps1
src/mocks/
src/hooks/__tests__/

# Local diagnostics (do not commit)
firestore.rules.prod.txt
firestore.indexes.prod.json
mcp_test.json

# Generated script output
scripts/out/

# Python / virtual environments
.venv/
.venv-*/
.venv_broken_*/
__pycache__/
*.pyc

# Generated / transient output
output/
*.bak
*.bak2
*.bak3
```