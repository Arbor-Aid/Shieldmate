{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrgProfile",
  "type": "object",
  "required": [
    "org_id",
    "org_name",
    "industry"
  ],
  "properties": {
    "org_id": {
      "type": "string"
    },
    "org_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "compliance_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
