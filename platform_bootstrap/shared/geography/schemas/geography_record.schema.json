  "title": "GeographyRecord",
  "type": "object",
  "required": [
    "country",
    "state",
    "county",
    "city",
    "zipcode"
  ],
  "properties": {
    "country": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "zipcode": {
      "type": "string"
    }
  }
}
