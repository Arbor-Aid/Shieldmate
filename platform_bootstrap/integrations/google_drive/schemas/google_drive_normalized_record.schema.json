{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoogleDriveNormalizedRecord",
  "type": "object",
  "required": [
    "source",
    "record_id",
    "title",
    "content_type",
    "ingested_at"
  ],
  "properties": {
    "source": {
      "const": "google_drive"
    },
    "record_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
