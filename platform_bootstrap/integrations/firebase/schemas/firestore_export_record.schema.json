{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirestoreExportRecord",
  "type": "object",
  "required": [
    "collection",
    "doc_id",
    "exported_at"
  ],
  "properties": {
    "collection": {
      "type": "string"
    },
    "doc_id": {
      "type": "string"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
